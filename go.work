// The workspace is committed so a checkout builds every module against the
// local pkg/ without replace directives. modules/weave-<os>-<capability>
// and cmd/* join the use block as they land. CI also builds every module with
// GOWORK=off, so a dependency missing from a module's own go.mod still fails.
go 1.27

use (
	./modules/weave-linux-exec
	./modules/weave-linux-power
	./modules/weave-linux-presence
	./modules/weave-linux-time
	./modules/weave-macos-exec
	./modules/weave-macos-power
	./modules/weave-macos-presence
	./modules/weave-macos-time
	./modules/weave-windows-exec
	./modules/weave-windows-power
	./modules/weave-windows-presence
	./modules/weave-windows-time
	./pkg
)
