// The workspace is committed so a checkout builds every module against the
// local sdk/ without a released sdk. CI also builds every module with
// GOWORK=off, so a dependency missing from a module's own go.mod still fails.
go 1.27.2

use (
	./modules/weave-linux-clipboard
	./modules/weave-linux-display
	./modules/weave-linux-exec
	./modules/weave-linux-metrics
	./modules/weave-linux-power
	./modules/weave-linux-presence
	./modules/weave-linux-session
	./modules/weave-linux-time
	./modules/weave-macos-clipboard
	./modules/weave-macos-display
	./modules/weave-macos-exec
	./modules/weave-macos-metrics
	./modules/weave-macos-power
	./modules/weave-macos-presence
	./modules/weave-macos-session
	./modules/weave-macos-time
	./modules/weave-windows-clipboard
	./modules/weave-windows-display
	./modules/weave-windows-exec
	./modules/weave-windows-metrics
	./modules/weave-windows-power
	./modules/weave-windows-presence
	./modules/weave-windows-session
	./modules/weave-windows-time
	./packaging/moduledeb
	./packaging/modulepkg
	./packaging/modulezip
	./sdk
)
